@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "_Layout";
    }
}

<div class="">
    <div>
        <div class="row">
            <div class="col-md-2">
                <partial name="_ManageNav"/>
            </div>
            <div class="col-md-9">
                <div class="pt-3">
                    <h1 class="text-primary">Account Management</h1>
                    <p class="text-muted" style="margin-top: -0.5rem">View and update your personal information, security settings, and preferences.</p>
                </div>
                <hr/>
                @RenderBody()
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
