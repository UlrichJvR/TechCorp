@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot password confirmation";
}

<style>
    body, html {
        height: 100%;
    }

    .center-screen {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .opaque {
        opacity: 0.5;
        transition: opacity 0.3s ease;
    }

    .opaque:hover {
        opacity: 1;
    }
</style>

<div class="center-screen">
    <div class="container" style="max-width: 35%;">
        <section class="shadow p-4 rounded bg-white border text-center">
            <a class="navbar-brand mb-3 d-block" asp-area="" asp-controller="Home" asp-action="Index">
                @await Html.PartialAsync("_NavLogo")
            </a>
            <h2 style="color: hotpink;">@ViewData["Title"]</h2>
            <p class="text-muted mt-3">
                Please check your email for a link to reset your password.
            </p>
            <a asp-page="./Login" class="btn btn-outline-primary mt-4">Back to Login</a>
        </section>
    </div>
</div>
