<style>
    .glassmorphic-card {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(12px);
        border-radius: 1rem;
        box-shadow: 0 0px 0px 0 rgba(31, 38, 135, 0.37);
        border: 1px solid rgba(255, 255, 255, 0.18);
    }

    .icon-container {
        position: relative;
        display: inline-block;
        height: 1rem;
        width: 1rem;
    }

    .icon-container img {
        position: absolute;
        top: 0;
        left: 0;
        transition: opacity 0.3s ease;
    }

    .icon-container .hover-icon {
        opacity: 0;
    }

    .login-btn:hover .hover-icon {
        opacity: 1;
    }

    .login-btn:hover .default-icon {
        opacity: 0;
    }

    .section-title {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 1.5rem;
        font-weight: 600;
    }

    hr {
        border-top: 2px solid #0d6efd; /* Bootstrap primary */
        margin: 0;
    }
</style>

<script>
    window.addEventListener('DOMContentLoaded', () => {
        // Reveal all the "rest" spans with delay after page load
        const rests = document.querySelectorAll('#ems-text .rest');
        rests.forEach((span, i) => {
            setTimeout(() => {
                span.style.opacity = '1';
            }, 500 + i * 400); // starts at 0.5s, then each next after 0.4s
        });
    });

    function toggleExpand(card) {
        // Collapse any other expanded card
        document.querySelectorAll('.expandable-card.expanded').forEach(function (otherCard) {
            if (otherCard !== card) {
                otherCard.classList.remove('expanded');
            }
        });

        // Toggle the clicked card
        card.classList.toggle('expanded');
    }
</script>


