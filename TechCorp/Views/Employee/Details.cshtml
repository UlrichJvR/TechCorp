@model TechCorp.Models.Employee

@{
    ViewData["Title"] = Model.EmployeeId == Guid.Empty ? "Add Employee" : "Employee Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center small">
    <a asp-action="Index" asp-controller="Employee" class="btn btn-link text-decoration-none text-primary-pink">
        <i class="bi bi-arrow-left"></i> Back to EMS Dashboard
    </a>
    <span class="" style="margin-left: -0.5rem; color: hotpink">/ Employee </span>
</div>

<div class="pt-2 row container ">
    <h1 class="text-primary">@ViewData["Title"]</h1>
    <p class="text-muted" style="margin-top: -0.5rem">Add, view and update your employee information.</p>
    <hr class="w-50" />
</div>

<div class="row container">
    <div class="col-md-6">
        <form method="post" asp-action="Edit" asp-controller="Employee" class="needs-validation">
            <input type="hidden" asp-for="EmployeeId" />

            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            <div class="form-floating mb-3">
                <input asp-for="FullName" class="form-control" placeholder="Enter full name" />
                <label asp-for="FullName"></label>
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="EmailAddress" class="form-control" autocomplete="email" placeholder="Enter email address" />
                <label asp-for="EmailAddress"></label>
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="JobTitle" class="form-control" placeholder="Enter job title" />
                <label asp-for="JobTitle"></label>
                <span asp-validation-for="JobTitle" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Department" class="form-control" placeholder="Enter department" />
                <label asp-for="Department"></label>
                <span asp-validation-for="Department" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary small">
                <i class="bi bi-save"></i> Save Employee
            </button>

            @* <div class="mt-3 text-center"> *@
            @*      *@
            @* </div> *@
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
